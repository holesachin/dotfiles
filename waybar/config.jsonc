{
	"position": "top",
	"output": "eDP-1",
	"height": 34,

	"modules-left":   [ "hyprland/workspaces", "hyprland/window" ],
	// "modules-center": [ "custom/block" ],
	"modules-right":  [ "battery", "tray", "clock" ],

	// modules
	"hyprland/window": {
		"format": "{}",
		"max-length": 70
	},

	"custom/block": {
		"format": "{}",
		"exec": "echo [ ]",
		"return-type": "text",
		"interval": "once",
		"signal": 1
	}, // pkill -RTMIN+1 waybar  to update module

	"hyprland/workspaces": {
		"all-outputs": true,
		"format": "{icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"5": "",
			"9": "󰨇",
		}
	},

	"custom/mpd": {
		"format": "♪ {text}",
		//"max-length": 15,
		"interval": 10,
		"exec": "mpc current",
		"exec-if": "pgrep mpd",
		"on-click": "mpc toggle",
		"on-click-right": "sonata"
	},

	"clock": {
		"format": "{:%d/%m %I:%M}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	},

	"tray": {
		"icon-size": 13,
		"spacing":5,
	},

	"cpu": {
		"interval": 10,
		"format":" {usage}%",
		"max-length": 20,
		"on-click": "kitty -e 'htop'"
	},

	"memory": {
		"interval": 10,
		"format": " {percentage}%",
		"max-length": 15,
		"tooltip": true,
		"warning": 70,
		"critical": 90,
		"tooltip-format": "{used:0.1f}G",
	},

	"battery": {
		"bat": "BAT0",
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon}",
		"tooltip": "{capacity}%",
		"format-charging": "󱊣",
		"format-plugged": "󰚥",
		"format-full": "",
		"format-icons": ["", "", "", ""],
	},

}
