#!/usr/bin/env bash
#
# tmux-resurrect-restore - Restore a specific session from resurrect backup
#

RESURRECT_DIR="${HOME}/.local/share/tmux/resurrect"
RESURRECT_LAST="${RESURRECT_DIR}/last"
RESURRECT_RESTORE_SCRIPT="${HOME}/.local/share/tmux/plugins/tmux-resurrect/scripts/restore.sh"

SESSION_NAME="$1"

# Check if session name provided
if [[ -z ${SESSION_NAME} ]]; then
	echo "Usage: $(basename $0) SESSION_NAME" >&2
	exit 1
fi

# Check if resurrect file exists
if [[ ! -f ${RESURRECT_LAST} ]]; then
	echo "Error: No resurrect save file found" >&2
	exit 1
fi

# Check if session exists in backup
if ! grep -qE "^(pane|window)\s+${SESSION_NAME}\s+" "${RESURRECT_LAST}"; then
	echo "Error: Session '${SESSION_NAME}' not found in backup" >&2
	exit 1
fi

# Create filtered file
FILTERED_FILE="${RESURRECT_DIR}/last.${SESSION_NAME}"
grep -E "^(pane|window)\s+${SESSION_NAME}\s+" "${RESURRECT_LAST}" > "${FILTERED_FILE}"
echo -e "state\t${SESSION_NAME}" >> "${FILTERED_FILE}"

# Backup original
BACKUP_FILE="${RESURRECT_DIR}/last.backup"
if [[ -L ${RESURRECT_LAST} ]]; then
	cp -P "${RESURRECT_LAST}" "${BACKUP_FILE}"
else
	cp "${RESURRECT_LAST}" "${BACKUP_FILE}"
fi

# Point to filtered file
rm "${RESURRECT_LAST}"
ln -sf "$(basename ${FILTERED_FILE})" "${RESURRECT_LAST}"

# Restore
"${RESURRECT_RESTORE_SCRIPT}"

# Restore original
rm "${RESURRECT_LAST}"
if [[ -L ${BACKUP_FILE} ]]; then
	cp -P "${BACKUP_FILE}" "${RESURRECT_LAST}"
else
	cp "${BACKUP_FILE}" "${RESURRECT_LAST}"
fi

# Cleanup
rm -f "${BACKUP_FILE}"
