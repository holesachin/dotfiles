#!/usr/bin/env bash
#
# tmux-sessionizer - Quickly create or switch to tmux sessions based on project directories
#

# === CONFIGURATION ===
DEFAULT_SESSION="$(hostname)"

DIRS=(
	~/
	~/dotfiles
	~/hobby
	~/znox
	~/dev
	~/etc
)

CONFIG_DIRS=(
	~/dotfiles
	~/nxc
	~/dotfiles/scripts
)

IGNORE_PATTERN=".git|.svn|.hg|.bzr|.idea|.DS_Store"

MENU="fzf --algo=v2 --no-scrollbar --no-border --tmux 100% --separator=\"-\" \
	--color=gutter:-1,bg+:-1,fg+:183,fg:60,pointer:169 \
	--info inline"

declare -A ICONS
ICONS[session]=" "
ICONS[dir]="󰉖 "
ICONS[file]=" "
ICONS[config]="󱁻 "

# === FUNCTIONS ===

# Build the options string with sessions and directories
get_options() {
	local sessions dirs
	sessions=$(tmux ls 2>/dev/null | cut -d':' -f1 | sed "s/^/${ICONS[session]}/")
	dirs=$(find "${DIRS[@]}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sed "s|^$HOME/||" | grep -Ev "$IGNORE_PATTERN" | sed "s/^/${ICONS[dir]}/")
	echo -e "$sessions\n$dirs"
}

# Display menu and get user selection
show_menu() {
	local options="$1"
	echo "$options" | ${MENU:-fzf} | cut -d' ' -f2
}

# Check if selected directory is in config dirs
is_config_dir() {
	local dir="$1"
	[[ " ${CONFIG_DIRS[@]} " =~ " $dir " ]]
}

# Handle file selection for config directories
handle_file_selection() {
	local selected_dir="$1"
	local selected_file
	selected_file=$(find "$selected_dir" -mindepth 1 -type f ! -name '.*' | sed "s|^$HOME/||" | grep -Ev "$IGNORE_PATTERN" | sed "s/^/${ICONS[config]}/" | show_menu)

	if [[ -n $selected_file ]]; then
		local filename
		filename=$(basename "$selected_file")
		local existing_window
		existing_window=$(tmux list-windows -t "$DEFAULT_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":$filename$" | cut -d: -f1)

		if [[ -n $existing_window ]]; then
			tmux select-window -t "$DEFAULT_SESSION:$existing_window"
		else
			tmux neww -t "$DEFAULT_SESSION" -n "$filename" "nvim '$selected_file'"
		fi
		tmux switch-client -t "$DEFAULT_SESSION"
	fi
}

# Create or attach to tmux session
create_or_attach_session() {
	local session_name="$1"
	local selected_dir="$2"

	if [[ -z $TMUX ]]; then
		# Not in tmux
		if tmux has-session -t "$session_name" 2>/dev/null; then
			tmux attach-session -t "$session_name"
		else
			tmux new-session -s "$session_name" -c "$selected_dir"
		fi
	else
		# Inside tmux
		if ! tmux has-session -t "$session_name" 2>/dev/null; then
			tmux new-session -ds "$session_name" -c "$selected_dir"
		fi
		tmux switch-client -t "$session_name"
	fi
}

# === MAIN ===
	local options selected_dir session_name
	
	# Get available options
	options=$(get_options)
	
	# Show menu and get selection
	selected_dir=$(show_menu "$options")
	
	# Exit if nothing selected
	[[ -z $selected_dir ]] && exit 0
	
	# Expand path if relative
	[[ $selected_dir != /* ]] && selected_dir="$HOME/$selected_dir"
	
	# Handle config directories (file listing)
	if is_config_dir "$selected_dir"; then
		handle_file_selection "$selected_dir"
		exit 0
	fi
	
	# Handle regular directories (session creation)
	session_name=$(basename "$selected_dir" | tr . _)
	create_or_attach_session "$session_name" "$selected_dir"
