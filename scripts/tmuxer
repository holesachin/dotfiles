#!/usr/bin/env bash
#
# tmux-sessionizer - Quickly create or switch to tmux sessions based on project directories
#

DEFAULT_SESSION="$(hostname)" 

DIRS=(
	~/
	~/dotfiles
	~/hobby
	~/znox
	~/dev
)

# Directories that should show file listing
FILE_LISTING_DIRS=(
	~/dotfiles
	~/nxc
	~/dotfiles/scripts
)

IGNORE_PATTERN=".git|.svn|.hg|.bzr|.idea|.DS_Store" 

MENU="fzf --algo=v2 --no-scrollbar --no-border --tmux 100% --separator="-"\
	--color=gutter:-1,bg+:-1,fg+:183,fg:60,pointer:169 \
	--info inline " 

# Icons
_tmux_icon=" "
_dir_icon="󰉖 "
_file_icon=" "
_config_icon="󱁻 "

OPTIONS=$({ tmux ls 2>/dev/null | cut -d':' -f1 | sed "s/^/${_tmux_icon}/"; \
	find "${DIRS[@]}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sed "s|^/home/$USER/||" | grep -Ev "$IGNORE_PATTERN" | sed "s/^/${_dir_icon}/";
})

# Find directories and let user select one with fzf
SELECTED_DIR=$(echo "$OPTIONS" | ${MENU:-fzf} | cut -d' ' -f2)

# Exit if no directory was selected
if [[ -z ${SELECTED_DIR} ]]; then
	exit 0
fi

# Expand ~ to full path for comparison
[[ ${SELECTED_DIR} != /* ]] && SELECTED_DIR="$HOME/${SELECTED_DIR}"

# If directory is a file listing directory, list files and let user select one with fzf and open with nvim
if [[ " ${FILE_LISTING_DIRS[@]} " =~ " ${SELECTED_DIR} " ]]; then
	SELECTED_FILE=$(find "${SELECTED_DIR}" -mindepth 1 -type f ! -name '.*' | sed "s|^/home/$USER/||" | grep -Ev "$IGNORE_PATTERN" | sed "s/^/${_config_icon}/"  | ${MENU:-fzf} | cut -d' ' -f2)
	if [[ -n ${SELECTED_FILE} ]]; then 
		FILENAME=$(basename ${SELECTED_FILE})
		# Check if a window with this filename already exists
		EXISTING_WINDOW=$(tmux list-windows -t ${DEFAULT_SESSION} -F "#{window_index}:#{window_name}" 2>/dev/null | \
			grep ":${FILENAME}$" | cut -d: -f1)

		if [[ -n ${EXISTING_WINDOW} ]]; then
			# Window exists, just switch to it
			tmux select-window -t ${DEFAULT_SESSION}:${EXISTING_WINDOW}
			tmux switch-client -t ${DEFAULT_SESSION}
		else
			# Create new window with the file and set window name
			tmux neww -t ${DEFAULT_SESSION} -n "${FILENAME}" "nvim '${SELECTED_FILE}'"
			tmux switch-client -t ${DEFAULT_SESSION}
		fi
	fi
	exit
fi

# Get the directory name to use as session name
SESSION_NAME="$(basename ${SELECTED_DIR} | tr . _)"

# Check if we're inside tmux
if [[ -z ${TMUX} ]]; then
	# Not in tmux - create new session or attach to existing one
	if tmux has-session -t "${SESSION_NAME}" 2>/dev/null; then
		tmux attach-session -t "${SESSION_NAME}"
	else
		tmux new-session -s "${SESSION_NAME}" -c "${SELECTED_DIR}"
	fi
else
	# Inside tmux - create session if it doesn't exist, then switch to it
	if ! tmux has-session -t "${SESSION_NAME}" 2>/dev/null; then
		tmux new-session -ds "${SESSION_NAME}" -c "${SELECTED_DIR}"
	fi
	tmux switch-client -t "${SESSION_NAME}"
fi

