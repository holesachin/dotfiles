# load and initialise completion system
autoload -Uz compinit
compinit

# zinit
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# fzf completion
source <(fzf --zsh)

# exercism completion
source <( exercism completion zsh)

# tailscale completion
source <(tailscale completion zsh)

# set zsh key
bindkey -v

