# path
export PATH="${PATH}:${HOME}/go/bin:${HOME}/.local/scripts"
export FZF_DEFAULT_OPTS="--info inline --no-scrollbar --color 'gutter:-1'"

# zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# plugins
zinit light zsh-users/zsh-autosuggestions
zinit light zdharma-continuum/fast-syntax-highlighting
zinit light MichaelAquilina/zsh-you-should-use

# android studio
export ANDROID_HOME=$HOME/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools
export PATH=$PATH:/opt/android-studio/bin
export CAPACITOR_ANDROID_STUDIO_PATH=/etc/profiles/per-user/sachin/bin/android-studio

# general alias
alias nixup='sudo nixos-rebuild switch --impure --flake ~/nxc\#nixos'
alias vim='nvim'
alias vi='nvim'
alias t="tmux -u attach -t ${HOST} || tmux -u new -s ${HOST}"
alias t="tmux -u attach -t ${HOST} || tmux -u new -s ${HOST}"
alias cp="rsync -av --progress"

# zsh promp
# PS1="%F{green}%B%m%b%f %1~ - "
PS1="%F{blue}[%F{green} $(grep '^ID=' /etc/os-release | cut -d'=' -f2):%F{purple}%1~ %F{blue}]%F{green} %f"

# show session name in prompt if in tmux
# if [[ ${TERM_PROGRAM} == "tmux" ]]; then
#   RPROMPT="%F{yellow}$(tmux display-message -p '#S')%f"
